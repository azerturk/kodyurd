{
  "name": "kodyurd-monorepo",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "npm run build -w @kodyurd/scene-schema && npm run build -w @kodyurd/server && npm run build -w @kodyurd/ui && npm run build -w kodyurd",
    "test": "node scripts/test.mjs",
    "dev:ui": "npm run dev -w @kodyurd/ui",
    "start": "node packages/cli/dist/index.js run",
    "doctor": "node packages/cli/dist/index.js doctor"
  }
}
